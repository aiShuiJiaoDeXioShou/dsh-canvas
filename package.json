{
  "name": "@local/dsh-canvas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Drafi: an AI-native design canvas for DeepSeek Harness with UI design tools, design foundations, deterministic audits, image generation, and selection-to-composer.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "dist",
    "client",
    "locale",
    "schema",
    "FORMAT.md",
    "DESIGN.md",
    "examples",
    "skills",
    "docs",
    "icon.svg",
    "icon.png",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.path.json --noEmit && tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "node build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiShuiJiaoDeXioShou/dsh-canvas.git"
  },
  "homepage": "https://github.com/aiShuiJiaoDeXioShou/dsh-canvas#readme",
  "license": "MIT"
}
