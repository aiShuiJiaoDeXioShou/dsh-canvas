{
  "name": "@local/dsh-canvas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Figma-style infinite canvas for DeepSeek Harness with an AI UI design skill, design foundation, deterministic audit, image generation, and selection-to-composer.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "locale",
    "schema",
    "FORMAT.md",
    "DESIGN.md",
    "examples",
    "skills",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiShuiJiaoDeXioShou/dsh-canvas.git"
  },
  "homepage": "https://github.com/aiShuiJiaoDeXioShou/dsh-canvas#readme",
  "license": "MIT"
}
